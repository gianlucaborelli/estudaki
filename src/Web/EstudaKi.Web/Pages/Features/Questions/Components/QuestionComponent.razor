@using Estudaki.Modules.Questions.Domain.ValueObjects

<MudCard Outlined="true">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                @if (Value?.PublicNotice != null)
                {
                    <MudText Typo="Typo.h6">
                        @Value.PublicNotice.ExamBoard - @Value.PublicNotice.Position @Value.PublicNotice.ExamPhase @Value.PublicNotice.Year
                    </MudText>
                }
                <MudButton Href="@($"/question/{Value?.Id}")" 
                           Variant="Variant.Text" 
                           Color="Color.Primary"
                           Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.OpenInNew">
                    Ver Detalhes
                </MudButton>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @* Renderiza os ContentBlocks (vertical) *@
        @if (Value?.QuestionContents != null)
        {
            foreach (var contentBlock in Value.QuestionContents.OrderBy(c => c.Order))
            {
                @if (contentBlock is ParagraphBlock paragraph)
                {
                    <MudText Align="Align.Justify" Class="mb-3">
                        @* Renderiza os InlineContents (horizontal) *@
                        @foreach (var inline in paragraph.Inlines)
                        {
                            <InlineContentRenderer Inline="@inline" />
                        }
                    </MudText>
                }
                else if (contentBlock is ImageBlock imageBlock)
                {
                    <div class="mb-3">
                        <img src="@GetImageUrl(imageBlock.Key)" 
                             alt="@imageBlock.Title" 
                             style="max-width: 100%; height: auto; display: block;" />
                        @if (!string.IsNullOrEmpty(imageBlock.Title))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">@imageBlock.Title</MudText>
                        }
                        @if (!string.IsNullOrEmpty(imageBlock.Source))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">Fonte: @imageBlock.Source</MudText>
                        }
                    </div>
                }
            }
        }

        @* Renderiza as alternativas *@
        @if (Value?.Choices != null && Value.Choices.Any())
        {
            <MudRadioGroup T="string" Value="_selectedValue" ValueChanged="OnAnswerSelected">
                @foreach (var choice in Value.Choices)
                {
                    string choiceClass = "choice";

                    if (_showAnswers)
                    {
                        if (choice.IsCorrect)
                            choiceClass += " correct";
                        else
                            choiceClass += " incorrect";
                    }

                    <div class="@choiceClass">
                        <MudRadio T="string" 
                                  Value="@choice.Option" 
                                  Color="Color.Primary">
                            <MudText Typo="Typo.body2" Align="Align.Justify">
                                @* Renderiza o conteúdo da alternativa (horizontal) *@
                                @foreach (var inline in choice.Content)
                                {
                                    <InlineContentRenderer Inline="@inline" />
                                }
                            </MudText>
                        </MudRadio>
                    </div>
                }
            </MudRadioGroup>
        }
    </MudCardContent>
    <MudCardActions>
        <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;">

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="ToggleAnswers">
                @if (_showAnswers)
                {
                    @:Ocultar resposta
                }
                else
                {
                    @:Verificar resposta
                }
            </MudButton>

            <MudSpacer />

            @if (Value?.PublicNotice?.HasAttachments == true)
            {
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Href="@Value?.PublicNotice?.ExamBookletUrl"
                               Target="_blank"
                               OnClick="OnDownloadExamBooklet">
                        Caderno de Questões
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Href="@Value?.PublicNotice?.AnswerKeyUrl"
                               Target="_blank"
                               OnClick="OnDownloadAnswerKey">
                        Gabarito
                    </MudButton>
                </MudStack>
            }

        </MudStack>
    </MudCardActions>
</MudCard>

