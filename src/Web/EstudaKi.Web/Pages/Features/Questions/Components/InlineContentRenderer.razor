@using Microsoft.JSInterop
@using Estudaki.Modules.Questions.Domain.ValueObjects
@inject IJSRuntime JSRuntime

@* Renderiza o conteúdo inline (TextInline, ImageInline, MathInline, ChemicalFormulaInline) *@
@if (Inline is TextInline textInline)
{
    <span style="@GetTextStyle(textInline)">@textInline.Text</span>
}
else if (Inline is ImageInline imageInline)
{
    <img src="@GetImageUrl(imageInline.Key)" 
         alt="@imageInline.Alt" 
         class="img-fluid rounded mx-1" 
         style="max-height: 300px; display: inline-block; vertical-align: middle;" />
}
else if (Inline is MathInline mathInline)
{
    <span class="math-inline-display" id="@mathElementId"></span>
}
else if (Inline is ChemicalFormulaInline chemicalInline)
{
    <span class="chemical-inline-display" id="@chemicalElementId"></span>
}
else
{
    @* Fallback caso o tipo não seja reconhecido *@
    <span class="text-danger">[@Inline?.GetType().Name - Type: @Inline?.Type]</span>
}

@code {
    [Parameter]
    public InlineContent? Inline { get; set; }

    private string mathElementId = string.Empty;
    private string chemicalElementId = string.Empty;
    private bool isRendered = false;

    protected override void OnInitialized()
    {
        mathElementId = $"math-inline-{Guid.NewGuid()}";
        chemicalElementId = $"chemical-inline-{Guid.NewGuid()}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isRendered = true;

            if (Inline is MathInline mathInline)
            {
                // Aguardar um pouco para garantir que o DOM está pronto
                await Task.Delay(100);
                await RenderMath(mathInline.Latex);
            }
            else if (Inline is ChemicalFormulaInline chemicalInline)
            {
                // Aguardar mais tempo para fórmulas químicas
                await Task.Delay(150);
                Console.WriteLine($"[InlineContentRenderer] Renderizando ChemicalInline: ID={chemicalElementId}, Formula={chemicalInline.Formula}");
                await RenderChemical(chemicalInline.Formula);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (isRendered)
        {
            if (Inline is MathInline mathInline)
            {
                await RenderMath(mathInline.Latex);
            }
            else if (Inline is ChemicalFormulaInline chemicalInline)
            {
                await RenderChemical(chemicalInline.Formula);
            }
        }
    }

    private async Task RenderMath(string latex)
    {
        if (string.IsNullOrEmpty(latex)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("MathQuillHelper.renderStatic", mathElementId, latex);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao renderizar fórmula matemática inline: {ex.Message}");
        }
    }

    private async Task RenderChemical(string formula)
    {
        if (string.IsNullOrEmpty(formula)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("ChemicalHelper.renderStatic", chemicalElementId, formula);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao renderizar fórmula química inline: {ex.Message}");
        }
    }

    private string GetTextStyle(TextInline textInline)
    {
        var styles = new List<string>();

        if (textInline.Bold)
            styles.Add("font-weight: bold");

        if (textInline.Italic)
            styles.Add("font-style: italic");

        return string.Join("; ", styles);
    }

    private string GetImageUrl(string key)
    {
        // TODO: Implementar lógica de storage (S3, Azure Blob, etc.)
        // Por enquanto retorna um placeholder ou URL local
        return $"/api/images/{key}";
    }
}
