@inherits MainLayoutPage

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<CascadingValue Value="this">
<MudLayout>
    <AppBarCustom @bind-IsDarkMode="_isDarkMode" />
    <MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />
    <MudMainContent Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="12">                
                @Body                
            </MudItem>            
        </MudGrid>
        <AppFooter />
    </MudMainContent>
</MudLayout>
</CascadingValue>