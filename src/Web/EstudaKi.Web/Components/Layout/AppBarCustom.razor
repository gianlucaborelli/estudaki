@inherits AppBarCustomBase

<MudPaper Class="search-bar" Elevation="2">
    <MudContainer MaxWidth="MaxWidth.Large">
        <!-- 🔝 Header -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">EstudaKi</MudText>
            <MudSpacer />            
            <DarkModeToggleSwitch IsDarkMode="@IsDarkMode" IsDarkModeChanged="@OnDarkModeChanged" />
        </MudStack>
        <!-- 🔍 Busca -->
        <MudTextField @bind-Value="_wordKey"
                      Placeholder="Buscar questões..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mt-2"
                      FullWidth="true" />

        <!-- 🔽 Toggle -->
        <MudButton Variant="Variant.Text"
                   Class="mt-1 pa-0"
                   OnClick="ToggleFilters">
            @(_showFilters ? "Ocultar filtros" : "Mostrar filtros")
        </MudButton>

        <!-- 🎛 Filtros -->
        <MudCollapse Expanded="_showFilters">

            <MudGrid Class="mt-2">

                <MudItem xs="12" md="4">
                    <MudSelectExtended T="string"
                                       ItemCollection="_questionType"
                                       @bind-SelectedValues="_questionTypeSelected"
                                       MultiSelection="true"
                                       Label="Tipo de Prova"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelectExtended T="string"
                                       ItemCollection="_mainArea"
                                       @bind-SelectedValues="_mainAreaSelected"
                                       MultiSelection="true"
                                       Label="Área de conhecimento"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelectExtended T="string"
                                       ItemCollection="_subArea"
                                       @bind-SelectedValues="_subAreaSelected"
                                       MultiSelection="true"
                                       OnClearButtonClick="LoadingFilterParameters"
                                       OnClose="LoadingFilterParameters"
                                       Label="Subárea"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-center mt-2">
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="SearchQuestions">
                        Pesquisar
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCollapse>
    </MudContainer>
</MudPaper>