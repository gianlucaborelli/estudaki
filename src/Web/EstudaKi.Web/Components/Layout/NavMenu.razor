@implements IDisposable

@inject NavigationManager NavigationManager

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>    
    
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="Account/Manage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">@context.User.Identity?.Name</MudNavLink>                    
        </Authorized>  
    </AuthorizeView>
    <AuthorizeView Roles="Admin, Backoffice">
        <Authorized>
            <MudNavGroup Title="BackOffice" Icon="@Icons.Material.Filled.Settings" Expanded="true">
                <MudNavLink Href="Backoffice/ExamManager" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ArtTrack">Provas</MudNavLink>
                <MudNavLink Href="Backoffice/AIPromptManager" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SmartToy">IA Prompt Manager</MudNavLink>
                <MudNavLink Href="..." Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">Usuários</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>


@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

