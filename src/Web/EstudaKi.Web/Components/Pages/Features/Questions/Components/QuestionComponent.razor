@using Estudaki.Modules.Questions.Domain.ValueObjects

<MudCard Outlined="true">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                
                <MudText Typo="Typo.h6">
                    @Value!.ExaminerOrganization - @Value!.Position @Value!.Phase @Value!.Year
                </MudText>
                
                <MudButton Href="@($"/question/{Value?.QuestionId}")" 
                           Variant="Variant.Text" 
                           Color="Color.Primary"
                           Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.OpenInNew">
                    Ver Detalhes
                </MudButton>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @* Renderiza os QuestionSupports (textos de apoio) antes do conteúdo da questão *@
        @if (Value?.QuestionSupports != null && Value.QuestionSupports.Any())
        {
            foreach (var questionSupport in Value.QuestionSupports)
            {
                <QuestionSupportRenderer QuestionSupport="@questionSupport" />
            }
        }

        @* Renderiza os ContentBlocks (vertical) *@
        @if (Value?.QuestionContents != null)
        {
            foreach (var contentBlock in Value.QuestionContents.OrderBy(c => c.Order))
            {
                @if (contentBlock is ParagraphBlock paragraph)
                {
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(paragraph.Title))
                        {
                            <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="mb-2 fw-bold">@paragraph.Title</MudText>
                        }
                        <MudText Align="Align.Justify">
                            @* Renderiza os InlineContents (horizontal) *@
                            @foreach (var inline in paragraph.Inlines)
                            {
                                <InlineContentRenderer Inline="@inline" />
                            }
                        </MudText>
                        @if (!string.IsNullOrEmpty(paragraph.Source))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Right" Color="Color.Secondary" Class="mt-1">Fonte: @paragraph.Source</MudText>
                        }
                    </div>
                }
                else if (contentBlock is ImageBlock imageBlock)
                {
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(imageBlock.Title))
                        {
                            <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="mb-2 fw-bold">@imageBlock.Title</MudText>
                        }
                        <img src="@GetImageUrl(imageBlock.Key)" 
                             alt="@imageBlock.Title" 
                             style="max-width: 100%; height: auto; display: block; margin: 0 auto;" />
                        @if (!string.IsNullOrEmpty(imageBlock.Source))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Right" Color="Color.Secondary" Class="mt-1">Fonte: @imageBlock.Source</MudText>
                        }
                    </div>
                }
            }
        }

        @* Renderiza as alternativas *@
        @if (Value?.Choices != null && Value.Choices.Any())
        {
            <MudRadioGroup T="string" Value="_selectedValue" ValueChanged="OnAnswerSelected">
                @foreach (var choice in Value.Choices)
                {
                    string choiceClass = "choice";

                    if (_showAnswers)
                    {
                        if (choice.IsCorrect)
                            choiceClass += " correct";
                        else
                            choiceClass += " incorrect";
                    }

                    <div class="@choiceClass">
                        <MudRadio T="string" 
                                  Value="@choice.Option" 
                                  Color="Color.Primary">
                            <MudText Typo="Typo.body2" Align="Align.Justify">
                                @* Renderiza o conteúdo da alternativa (horizontal) *@
                                @foreach (var inline in choice.Content)
                                {
                                    <InlineContentRenderer Inline="@inline" />
                                }
                            </MudText>
                        </MudRadio>
                    </div>
                }
            </MudRadioGroup>
        }
    </MudCardContent>
    <MudCardActions>
        <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="ToggleAnswers">
                @if (_showAnswers)
                {
                    @:Ocultar resposta
                }
                else
                {
                    @:Verificar resposta
                }
            </MudButton>

            <MudSpacer />

            <MudStack Row="true" Spacing="2">
            @if (!string.IsNullOrEmpty(Value?.ExamBookletUrl))
            {            
                <MudButton Variant="Variant.Outlined"
                            Color="Color.Primary"
                            Href="@Value?.ExamBookletUrl"
                            Target="_blank"
                            OnClick="OnDownloadExamBooklet">
                    Caderno de Questões
                </MudButton>
            }
            @if (!string.IsNullOrEmpty(Value?.AnswerKeyUrl))
            {
                <MudButton Variant="Variant.Outlined"
                            Color="Color.Primary"
                            Href="@Value?.AnswerKeyUrl"
                            Target="_blank"
                            OnClick="OnDownloadAnswerKey">
                    Gabarito
                </MudButton>                
            }
            </MudStack>
        </MudStack>
    </MudCardActions>
</MudCard>

