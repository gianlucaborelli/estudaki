@using Microsoft.JSInterop
@using Estudaki.Modules.Questions.Domain.ValueObjects
@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime

<style>
    .preserve-linebreaks {
        white-space: pre-line;
    }
</style>

@* Renderiza o conteúdo inline processando tags especiais dentro do TextInline *@
@if (Inline is TextInline textInline)
{
    <span class="preserve-linebreaks">
        @foreach (var part in ParseTextParts(textInline.Text))
        {
            @part
        }
    </span>    
}
else
{
    @* Fallback caso o tipo não seja reconhecido *@
    <span class="text-danger">[@Inline?.GetType().Name - Type: @Inline?.Type]</span>
}

@code {
    [Parameter]
    public InlineContent? Inline { get; set; }

    private List<(string id, string content, string type)> specialTags = new();

    private List<RenderFragment> ParseTextParts(string html)
    {
        var parts = new List<RenderFragment>();
        if (string.IsNullOrEmpty(html)) return parts;

        specialTags.Clear();

        var pattern = @"<(math|chemical)>([\s\S]*?)<\/\1>";
        var matches = Regex.Matches(html, pattern, RegexOptions.IgnoreCase);

        int lastIndex = 0;

        foreach (Match match in matches)
        {
            if (match.Index > lastIndex)
            {
                var textBefore = html.Substring(lastIndex, match.Index - lastIndex);
                parts.Add(CreateMarkupFragment(textBefore));
            }

            var tagType = match.Groups[1].Value.ToLower();
            var content = match.Groups[2].Value.Trim();
            var id = $"{tagType}-inline-{Guid.NewGuid():N}";

            specialTags.Add((id, content, tagType));

            if (tagType == "math")
            {
                parts.Add(CreateMathFragment(id, content));
            }
            else if (tagType == "chemical")
            {
                parts.Add(CreateChemicalFragment(id, content));
            }

            lastIndex = match.Index + match.Length;
        }

        if (lastIndex < html.Length)
        {
            var textAfter = html.Substring(lastIndex);
            parts.Add(CreateMarkupFragment(textAfter));
        }

        return parts;
    }

    private RenderFragment CreateMarkupFragment(string html) => builder =>
    {
        builder.AddContent(0, (MarkupString)html);
    };

    private RenderFragment CreateMathFragment(string id, string latex) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "math-inline-display");
        builder.AddAttribute(2, "id", id);
        builder.AddElementReferenceCapture(3, async elementRef =>
        {
            await Task.Delay(100);
            try
            {
                await JSRuntime.InvokeVoidAsync("MathQuillHelper.renderStatic", id, latex);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[InlineContentRenderer] Erro ao renderizar math {id}: {ex.Message}");
            }
        });
        builder.CloseElement();
    };

    private RenderFragment CreateChemicalFragment(string id, string formula) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "chemical-inline-display");
        builder.AddAttribute(2, "id", id);
        builder.AddElementReferenceCapture(3, async elementRef =>
        {
            await Task.Delay(150);
            try
            {
                await JSRuntime.InvokeVoidAsync("ChemicalHelper.renderStatic", id, formula);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[InlineContentRenderer] Erro ao renderizar chemical {id}: {ex.Message}");
            }
        });
        builder.CloseElement();
    };    
}
