@using Estudaki.Commons.Core.AI.Prompts
@inherits AIPromptEditorModalBase

<MudDialog>
    <TitleContent>
        @(IsEditMode ? "Editar Prompt" : "Novo Prompt")
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="Name"
                      Label="Nome"
                      Placeholder="ex.: review-question"
                      Disabled="IsEditMode"
                      Required="true" />

        <MudTextField @bind-Value="Description"
                      Label="Descrição"
                      Class="mt-3" />

        <MudTextField @bind-Value="Content"
                      Label="Conteúdo do Prompt"
                      Lines="8"
                      Required="true"
                      Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="IsSaving"
                   OnClick="Save">
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>
