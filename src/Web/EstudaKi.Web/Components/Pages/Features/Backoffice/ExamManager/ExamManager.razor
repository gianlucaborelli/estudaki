@page "/Backoffice/ExamManager/{id}"
@using EstudaKi.Web.Components.Pages.Features.Questions.Components
@using Estudaki.Modules.Questions.Application.DTOs
@using Estudaki.Modules.Questions.Domain.Entities
@using Estudaki.Modules.Questions.Domain.ValueObjects

@inherits ExamManagerBase
@attribute [Authorize(Roles = "Admin,Backoffice")]

<style>
    .selected {
        background-color: #1E88E5 !important;
    }

    .selected > td {
        color: white !important;
    }

    .selected > td .mud-input {
        color: white !important;
    }
</style>

<MudText Typo="Typo.h5" Align="Align.Center">Gerenciar Prova</MudText>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else
{
    <CascadingValue Value="PublicNotice" Name="PublicNotice">
    <MudPaper Elevation="25">
        <MudToolBar Dense="true">            
            <MudTooltip Text="Editar Prova" Arrow="true" Placement="Placement.Top">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditPublicNoticeDialogAsync()"/>
            </MudTooltip>
            <MudTooltip Text="Adicionar Imagens" Arrow="true" Placement="Placement.Top">
                <MudIconButton Icon="@Icons.Material.Filled.AddPhotoAlternate" OnClick="() => OpenUploadImagesDialogAsync()" />
            </MudTooltip>
            <MudTooltip Text="Anexar Arquivos" Arrow="true" Placement="Placement.Top">
                <MudIconButton Icon="@Icons.Material.Filled.AttachFile" OnClick="() => OpenUploadFileDialogAsync()" />
            </MudTooltip>
        </MudToolBar>
    </MudPaper>



    @* Public Notice Details *@
    <MudPaper Class="pa-6 my-2" Elevation="2">
    @if (PublicNotice == null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5" Class="fw-bold">
                     @ExamCategories.GetDisplayName(PublicNotice.ExamCategory!)
                </MudText>

                <MudSpacer />

                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                    Nº @PublicNotice.Number
                </MudChip>
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                    @((PublicNotice.Year > 0) ? PublicNotice.Year.ToString() : "Ano não definido")
                </MudChip>
            </MudStack>

            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Banca</MudText>
                    <MudText>@(PublicNotice.ExaminerOrganization ?? "Não definido")</MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Categoria</MudText>
                            <MudText>@(PublicNotice.ExamCategory ?? "Não definido")</MudText>
                </MudItem>                
            </MudGrid>

            <MudDivider />

            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudSelect @bind-Value="SelectedExam"
                            Variant="Variant.Filled"
                            Label="Exames"
                            onchange="() => LoadContent()"
                            Style="width: auto; min-width: 200px;">
                    @foreach (var exam in PublicNotice.Exams)
                    {
                        <MudSelectItem Value="exam">@exam.Phase - @exam.Area - @exam.Position - @exam.EducationLevel</MudSelectItem>
                    }
                </MudSelect>                
            </MudStack>
        </MudStack>
    }
    </MudPaper>

    @* Exam Details *@

    <MudPaper Class="pa-6 my-2" Elevation="2">
    @if (SelectedExam != null)        
    {
        <MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5" Class="fw-bold">
                    @ExamCategories.GetDisplayName(PublicNotice.ExamCategory!)
                </MudText>

                <MudSpacer />

                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                    Nº @PublicNotice.Number
                </MudChip>
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                    @((PublicNotice.Year > 0) ? PublicNotice.Year.ToString() : "Ano não definido")
                </MudChip>
            </MudStack>

            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Banca</MudText>
                    <MudText>@(PublicNotice.ExaminerOrganization ?? "Não definido")</MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Fase</MudText>
                    <MudText>@(SelectedExam.Phase ?? "Não definido")</MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Cargo</MudText>
                    <MudText>@(SelectedExam.Position ?? "Não definido")</MudText>
                </MudItem>
            </MudGrid>

            <MudDivider />

            <MudStack Row="true" AlignItems="AlignItems.Center">

                <MudChip T="string" Color="Color.Info" Variant="Variant.Filled">
                    Total: @(QuestionList?.Count ?? 0)
                </MudChip>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                    Múltipla: @(QuestionList.Count(q => q.QuestionType == "multiple-choice"))
                </MudChip>
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                    Aberta: @(QuestionList.Count(q => q.QuestionType == "open-ended"))
                </MudChip>
                <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Outlined">
                    Redação: @(QuestionList.Count(q => q.QuestionType == "redaction"))
                </MudChip>

                <MudSpacer />

                @if (!string.IsNullOrEmpty(SelectedExam?.ExamBookletUrl))
                {
                    <MudButton Variant="Variant.Outlined"
                                StartIcon="@Icons.Material.Filled.Description"
                                Href="@SelectedExam.ExamBookletUrl"
                                Target="_blank">
                        Caderno
                    </MudButton>
                }
                @if (!string.IsNullOrEmpty(SelectedExam?.AnswerKeyUrl))
                {
                    <MudButton Variant="Variant.Outlined"
                                StartIcon="@Icons.Material.Filled.TaskAlt"
                                Href="@SelectedExam.AnswerKeyUrl"
                                Target="_blank">
                        Gabarito
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    }
    </MudPaper>
































    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
        <MudTabPanel Text="Questões">
            <MudGrid>
                <!-- Ocupa 1/4 -->
                <MudItem xs="12" md="3">
                    <MudTable T="QuestionDto" 
                        @bind-SelectedItem="SelectedQuestion" 
                        Items="@QuestionList.OrderBy(q => q.QuestionNumber)" 
                        Hover="true"     
                        Dense="true"
                        Breakpoint="Breakpoint.Sm" 
                        Loading="@IsLoading"
                        OnRowClick="@QuestionsRowClickEvent"
                        RowClassFunc="@SelectedQuestionRowClassFunc"
                        LoadingProgressColor="Color.Info">
                        <HeaderContent>
                            <MudTh>Nr</MudTh>
                            <MudTh>Tipo</MudTh>
                            <MudTh>Qt. Alt</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Nr">@context.QuestionNumber</MudTd>
                            <MudTd DataLabel="Tipo">@QuestionType.GetDisplayName(context.QuestionType)</MudTd>
                            <MudTd DataLabel="Qt. Alt">@context.Choices?.Count()</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager HidePageNumber="true" />
                        </PagerContent>
                    </MudTable>
                </MudItem>

                <!-- Ocupa 3/4 -->
                <MudItem xs="12" md="9">
                    <MudToolBar Dense="true">                        
                        <MudTooltip Text="Editar Questão" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Disabled="@(SelectedQuestion == null)" OnClick="() => OpenQuestionEditorModalAsync()" />
                        </MudTooltip>
                        <MudTooltip Text="Remover Questão" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Disabled="@(SelectedQuestion == null)" OnClick="() => DeleteQuestionAsync()" />
                        </MudTooltip>
                    </MudToolBar>
                    @if (SelectedQuestion == null)
                    {
                        <MudText>Selecione uma questão para visualizar o conteúdo.</MudText>
                    }
                    else
                    {
                        <QuestionComponent Value="SelectedQuestion" />
                    }                    
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Suporte de Questões">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudTable T="QuestionSupportDto"
                              @bind-SelectedItem="SelectedQuestionSupport"
                              Items="QuestionSupports"
                              Hover="true"
                              Dense="true"
                              Breakpoint="Breakpoint.Sm"
                              Loading="@IsLoading"
                              OnRowClick="@QuestionSupportRowClickEvent"
                              RowClassFunc="@SelectedQuestionSupportRowClassFunc"
                              LoadingProgressColor="Color.Info">
                        <HeaderContent>
                            <MudTh>Nr</MudTh>
                            <MudTh>Itens</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Nr">@context.Id</MudTd>
                            <MudTd DataLabel="Itens">@context.Contents?.Count()</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager HidePageNumber="true"/>
                        </PagerContent>
                    </MudTable>
                </MudItem>
                <MudItem xs="12" md="9">
                    <MudToolBar Dense="true">
                        <MudTooltip Text="Adicionar Suporte" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                            OnClick="() => OpenQuestionSupportEditorModalAsync(true)" />
                        </MudTooltip>
                        <MudTooltip Text="Editar Suporte" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                            Disabled="@(SelectedQuestionSupport == null)" 
                                            OnClick="() => OpenQuestionSupportEditorModalAsync()" />
                        </MudTooltip>
                        <MudTooltip Text="Remover Suporte" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                            Disabled="@(SelectedQuestionSupport == null)" 
                                            OnClick="() => DeleteQuestionSupportAsync()" />
                        </MudTooltip>
                    </MudToolBar>
                    @if(SelectedQuestionSupport == null)
                    {
                        <MudText>Selecione um suporte de questão para visualizar o conteúdo.</MudText>
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6" Class="fw-bold">Suporte de Questão - ID: @SelectedQuestionSupport.Id</MudText>
                            <MudSpacer />
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled">
                                Total de Itens: @(SelectedQuestionSupport.Contents?.Count() ?? 0)
                            </MudChip>
                        </MudStack>
                    }
                    @if (SelectedQuestionSupport != null)
                    {
                        <QuestionSupportRenderer QuestionSupport="SelectedQuestionSupport" 
                                                 PublicNotice="PublicNotice" />
                    }
                    else
                    {
                        <MudText>Selecione um suporte de questão para visualizar o conteúdo.</MudText>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="Imagens">
            <MudText>Content Two</MudText>
        </MudTabPanel>
    </MudTabs>
    </CascadingValue>
}
