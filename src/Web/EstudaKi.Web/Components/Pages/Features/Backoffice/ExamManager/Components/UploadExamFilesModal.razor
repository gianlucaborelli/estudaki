@using Estudaki.Commons.Core.Storage
@using Estudaki.Modules.Questions.Domain.Extensions
@using Estudaki.Modules.Questions.Domain.Entities
@inject IStorageService StorageService

<div class="modal fade @(IsVisible ? "show" : "")" style="display: @(IsVisible ? "block" : "none")" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-cloud-upload me-2"></i>
                    Upload de Arquivos do Edital
                </h5>
                <button type="button" class="btn-close" @onclick="Close" disabled="@isUploading"></button>
            </div>
            <div class="modal-body">
                @if (Notice != null)
                {
                    <div class="mb-3">
                        <div class="alert alert-info">
                            <strong>Edital:</strong> @Notice.Number - @Notice.Year<br />
                            <strong>Banca:</strong> @Notice.ExamBoard<br />
                            <strong>Pasta:</strong> <code>@Notice.GetExamFolder(StorageService)</code>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="bi bi-file-pdf me-1"></i>
                            Caderno de Questões *
                        </label>
                        <InputFile OnChange="OnExamFileSelected" class="form-control" accept=".pdf" disabled="@isUploading" />
                        @if (!string.IsNullOrEmpty(examFileName))
                        {
                            <div class="mt-2 text-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Arquivo selecionado: @examFileName
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-file-pdf me-1"></i>
                            Gabarito *
                        </label>
                        <InputFile OnChange="OnAnswerKeyFileSelected" class="form-control" accept=".pdf" disabled="@isUploading" />
                        @if (!string.IsNullOrEmpty(answerKeyFileName))
                        {
                            <div class="mt-2 text-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Arquivo selecionado: @answerKeyFileName
                            </div>
                        }
                    </div>

                    @if (isUploading)
                    {
                        <div class="alert alert-warning">
                            <div class="d-flex align-items-center">
                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">Enviando...</span>
                                </div>
                                <span>Enviando arquivos para AWS S3...</span>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            @errorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-1"></i>
                            @successMessage
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@isUploading">
                    Cancelar
                </button>
                <button type="button" class="btn btn-primary" @onclick="UploadFiles" disabled="@(!CanUpload() || isUploading)">
                    <i class="bi bi-cloud-upload me-1"></i>
                    Upload
                </button>
            </div>
        </div>
    </div>
</div>

@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public PublicNotice? Notice { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnUploadSuccess { get; set; }

    private IBrowserFile? examFile;
    private IBrowserFile? answerKeyFile;
    private string? examFileName;
    private string? answerKeyFileName;
    private bool isUploading = false;
    private string? errorMessage;
    private string? successMessage;

    private void OnExamFileSelected(InputFileChangeEventArgs e)
    {
        examFile = e.File;
        examFileName = e.File.Name;
        errorMessage = null;
        successMessage = null;
    }

    private void OnAnswerKeyFileSelected(InputFileChangeEventArgs e)
    {
        answerKeyFile = e.File;
        answerKeyFileName = e.File.Name;
        errorMessage = null;
        successMessage = null;
    }

    private bool CanUpload()
    {
        return Notice != null && examFile != null && answerKeyFile != null;
    }

    private async Task UploadFiles()
    {
        if (!CanUpload() || Notice == null || examFile == null || answerKeyFile == null)
            return;

        isUploading = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        try
        {
            // Upload do caderno de questões
            using (var examStream = examFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024)) // 50 MB
            {
                var examFileName = Notice.GetExamFileName();
                await StorageService.UploadFileAsync(examStream, examFileName, "application/pdf");
            }

            // Upload do gabarito
            using (var answerKeyStream = answerKeyFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024)) // 50 MB
            {
                var answerKeyFileName = Notice.GetAnswerKeyFileName();
                await StorageService.UploadFileAsync(answerKeyStream, answerKeyFileName, "application/pdf");
            }

            successMessage = "Arquivos enviados com sucesso!";
            await Task.Delay(1500); // Mostra mensagem de sucesso por 1.5s

            // Limpa os arquivos
            examFile = null;
            answerKeyFile = null;
            examFileName = null;
            answerKeyFileName = null;

            await OnUploadSuccess.InvokeAsync();
            await Close();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao enviar arquivos: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task Close()
    {
        if (isUploading)
            return;

        IsVisible = false;
        examFile = null;
        answerKeyFile = null;
        examFileName = null;
        answerKeyFileName = null;
        errorMessage = null;
        successMessage = null;
        await OnClose.InvokeAsync();
    }
}
