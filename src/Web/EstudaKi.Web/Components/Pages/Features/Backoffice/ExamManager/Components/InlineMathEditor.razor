@using Microsoft.JSInterop


@inherits InlineMathEditorBase

<MudTextField Value="@Latex"
              ValueChanged="@(async (string value) => await OnLatexChanged(value))"
              Variant="Variant.Outlined"
              Immediate="true"
              Label="Fórmula LaTeX"
              Lines="2"/>      

<div class="mb-2">
    <label class="form-label fw-bold">Preview (Renderizado):</label>
    <div class="math-preview border rounded p-3 bg-light" 
            id="@previewId" 
            style="min-height: 60px; font-size: 1.2rem;">
    </div>
</div>

