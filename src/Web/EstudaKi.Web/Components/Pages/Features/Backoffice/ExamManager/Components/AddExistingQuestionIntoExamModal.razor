@using EstudaKi.Web.Components.Pages.Features.Questions.Components
@using Estudaki.Modules.Questions.Application.DTOs
@inherits AddExistingQuestionIntoExamModalBase

<style>
    .selected {
        background-color: #1E88E5 !important;
    }

    .selected > td {
        color: white !important;
    }

    .selected > td .mud-input {
        color: white !important;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudText Typo="Typo.h6">Questões Disponíveis</MudText>
                <MudTable T="QuestionDto" Items="Questions"
                          @bind-SelectedItem="SelectedQuestion"       
                          RowClassFunc="@SelectedQuestionRowClassFunc"
                          Filter="new Func<QuestionDto,bool>(FilterFunc1)"
                          Hover="true"
                          Dense="true">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Questões Disponiveis</MudText>
                        <MudSpacer />
                        <MudTextField 
                            @bind-Value="SearchString"
                            Immediate="true"
                            Placeholder="Pesquisar..." 
                            Adornment="Adornment.Start" 
                            AdornmentIcon="@Icons.Material.Filled.Search" 
                            IconSize="Size.Medium" 
                            Class="mt-0" />
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Questão</MudTh>
                        <MudTh>Cargo</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.GetQuestionPreview(100)</MudTd>
                        <MudTd>@string.Join(", ", context.Positions) (@context.Area)</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager HidePageNumber="true" />
                    </PagerContent>
                </MudTable>
            </MudItem>
            <MudItem xs="12" md="1">
                <MudDivider Vertical="true" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudText Typo="Typo.h6">Questões Selecionadas</MudText>
                @if(SelectedQuestion != null)
                {
                    <QuestionComponent Value="SelectedQuestion" />
                }                
            </MudItem>
        </MudGrid>
        
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="() => AddQuestionToExam()">Adicionar</MudButton>
        <MudButton Color="Color.Secondary" OnClick="() => Dialog.Cancel()">Cancelar</MudButton>
    </DialogActions>
</MudDialog>
