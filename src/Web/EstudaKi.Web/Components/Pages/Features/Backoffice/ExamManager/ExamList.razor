@page "/Backoffice/ExamManager"
@using Estudaki.Modules.Questions.Application.DTOs
@using Estudaki.Modules.Questions.Domain.ValueObjects

@inherits ExamListBase
@attribute [Authorize(Roles = "Admin,Backoffice")]

<MudText Typo="Typo.h5" Align="Align.Center">Lista de Provas</MudText>

<MudToolBar>    
    <MudTooltip Text="Criar" Arrow="true" Placement="Placement.Top">
        <MudIconButton OnClick="OpenCreateNewPublicNoticeDialogAsync" Icon="@Icons.Material.Filled.Add" /> @* Criar *@
    </MudTooltip>
    <MudSpacer />    
    @if (SelectedItems.Count > 0)    
    {
        <MudText Typo="Typo.subtitle1" Align="Align.Center">@SelectedItems.Count item(s) selecionado(s)</MudText>
        @if (SelectedItems.Count > 1)
        {
            <MudTooltip Text="Unificar Provas" Arrow="true" Placement="Placement.Top">
                <MudIconButton OnClick="UnifyPublicNoticeAsync" Icon="@Icons.Material.Filled.FileCopy" /> @* Unificar provas *@
            </MudTooltip>
        }        
        <MudTooltip Text="Publicar" Arrow="true" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.Publish" /> @* Publica *@
        </MudTooltip>
        <MudTooltip Text="Despublicar" Arrow="true" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.Download" />   @* Despublica *@
        </MudTooltip>
        <MudTooltip Text="Deletar" Arrow="true" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" />   @* Deleta *@
        </MudTooltip>
    }
</MudToolBar>

<MudTable 
    Items="@PublicNoticeList" 
    T="PublicNoticeDto" 
    MultiSelection="true" 
    SelectedItemsChanged="OnSelectedItemsChanged"
    Hover="true" 
    Dense="true"
    Breakpoint="Breakpoint.Sm" 
    Loading="@IsLoading" 
    LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Banca</MudTh>
        <MudTh>Contratante</MudTh>
        <MudTh>Ano</MudTh>
        <MudTh>Nr</MudTh>
        <MudTh>Categoria</MudTh>
        <MudTh>Qt Exames</MudTh>
        <MudTh>Qt Questões</MudTh>
        <MudTh>Publicado</MudTh>
        <MudTh>Revisado</MudTh>
        <MudTh>Criado em</MudTh>
        <MudTh>Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Banca">@context.ExaminerOrganization</MudTd>
        <MudTd DataLabel="Contratante">@context.ContractingOrganization</MudTd>
        <MudTd DataLabel="Ano">@context.Year</MudTd>
        <MudTd DataLabel="Nr">@context.Number</MudTd>
        <MudTd DataLabel="Categoria">@ExamCategories.GetDisplayName(context.ExamCategory!)</MudTd>
        <MudTd DataLabel="Qt Exames">@context.Exams.Count</MudTd>
        <MudTd DataLabel="Qt Questões">@context.QuestionCount</MudTd>
        <MudTd DataLabel="Publicado">
            <MudIcon Icon="@(context.IsPublished ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                     Color="@(context.IsPublished ? Color.Success : Color.Error)" />
        </MudTd>
        <MudTd DataLabel="Revisado">
            <MudIcon Icon="@(context.IsPublished ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                     Color="@(context.IsPublished ? Color.Success : Color.Error)" />
        </MudTd>
        <MudTd DataLabel="CreatedAt">@context.CreatedAt</MudTd>
        <MudTd DataLabel="Ações">

            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Color="Color.Primary"
                           OnClick="@(() => Edit(context))" />

            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           OnClick="@(() => Delete(context))" />

        </MudTd>
    </RowTemplate>
</MudTable>



