@* Dialog de Vincular Textos de Apoio *@

@inherits QuestionSupportSelectorBase

<div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.7); z-index: 2000;" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">          
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Selecione os textos de apoio que deseja vincular a esta questão.
                </div>

                @if (AvailableQuestionSupports != null && AvailableQuestionSupports.Any())
                {
                    <div class="list-group">
                        @foreach (var (support, index) in AvailableQuestionSupports.Select((s, i) => (s, i + 1)))
                        {
                            @* var isLinked = Question.QuestionSupports.Contains(support.Id);
                            var preview = GetSupportPreview(support);
                            <div class="list-group-item">
                                <div class="form-check">
                                    <input class="form-check-input" 
                                            type="checkbox" 
                                            id="@($"support-{support.Id}")"
                                            checked="@isLinked"
                                            @onchange="() => ToggleQuestionSupport(support.Id)">
                                    <label class="form-check-label w-100" for="@($"support-{support.Id}")">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-start mb-1">
                                                    <strong>Texto de Apoio #@index</strong>
                                                    @if (isLinked)
                                                    {
                                                        <span class="badge bg-success ms-2">Vinculado</span>
                                                    }
                                                </div>
                                                <small class="text-muted d-block mb-1">@support.Contents.Count bloco(s) de conteúdo</small>
                                                @if (!string.IsNullOrEmpty(preview))
                                                {
                                                    <div class="bg-light border rounded p-2 mt-2" style="font-size: 0.85rem;">
                                                        <strong class="text-primary">Preview:</strong>
                                                        <div class="text-muted" style="white-space: pre-wrap; max-height: 60px; overflow: hidden; text-overflow: ellipsis;">@preview</div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div> *@
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Não há textos de apoio disponíveis para vincular.
                    </div>
                }
            </div>
            <div class="modal-footer">
                @* <button type="button" class="btn btn-primary" @onclick="CloseLinkSupportDialog">
                    <i class="bi bi-check-circle me-1"></i>Concluir
                </button> *@
            </div>
        </div>
    </div>
</div>

