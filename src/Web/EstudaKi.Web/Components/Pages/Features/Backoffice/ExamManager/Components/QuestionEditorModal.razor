@using Estudaki.Modules.Questions.Application.DTOs
@using Estudaki.Modules.Questions.Domain.Entities
@using Estudaki.Modules.Questions.Domain.ValueObjects

@inherits QuestionEditorModalBase

<MudDialog>
    <DialogContent>
        <EditForm Model="@Question">          
                
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="EditedQuestion.QuestionNumber" Label="Número" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="EditedQuestion.MainArea" Label="Área Principal" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="EditedQuestion.SubAreas" Label="Subareas" />
                </MudItem>                    
                <MudItem xs="12" md="6">
                    <MudSelect @bind-Value="EditedQuestion.QuestionType" Label="Tipo de questão">
                        @foreach (var type in QuestionType.All)
                        {
                            <MudSelectItem Value="@type">@QuestionType.GetDisplayName(type)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid Class="py-5">
                        <MudCheckBox @bind-Value="EditedQuestion.IsNullified" Label="Anulada Pela Banca" />
                        <MudSpacer />
                        <MudCheckBox @bind-Value="EditedQuestion.IsPublished" Label="Publicado" />                            
                    </MudGrid>
                </MudItem>
            </MudGrid>

            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
                <MudTabPanel Text="Enunciado">
                    <ContentBlockEditor ContentBlocks="@EditedQuestion.QuestionContents" />
                </MudTabPanel>
                <MudTabPanel Text="@($"Alternativas ({EditedQuestion.Choices?.Count ?? 0})")">
                    <MudButton Size="Size.Small"                                
                                Variant="Variant.Filled"
                                Color="Color.Success"
                                StartIcon="@Icons.Material.Filled.Add"
                                OnClick="AddChoice">
                        Adicionar Alternativa
                    </MudButton>
                    @if (EditedQuestion.Choices != null && EditedQuestion.Choices.Any())
                    {
                        <MudStack Row="false">
                            @foreach(var choice in EditedQuestion.Choices)
                            {
                                <MudPaper Class="pa-3 my-2" Elevation="2" Rounded="true">
                                    <MudGrid Spacing="2" Class="my-3">
                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="choice.Option" Label="Letra da Alternativa" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudCheckBox @bind-Value="choice.IsCorrect" Label="Resposta Correta" />
                                        </MudItem>
                                        <MudItem>
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Filled"
                                                       Color="Color.Error"
                                                       StartIcon="@Icons.Material.Filled.Delete"
                                                       OnClick="() => RemoveChoice(choice)">
                                                Remover
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>
                                    <ContentInlineEditor Inlines="choice.Content" />
                                </MudPaper>                                                       
                            }
                        </MudStack>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Nenhuma alternativa adicionada. Clique no botão acima para adicionar alternativas.
                        </div>
                    }
                </MudTabPanel>
                <MudTabPanel Text="@($"Textos de Apoio ({EditedQuestion.QuestionSupports?.Count ?? 0})")">
                    <MudButton Size="Size.Small"
                                Variant="Variant.Filled"
                                Color="Color.Info"
                                Disabled="true"
                                StartIcon="@Icons.Material.Filled.Link">
                                
                        Adicionar Texto de Apoio
                    </MudButton>                   
                    
                    @if (EditedQuestion.QuestionSupports != null)
                    {
                        <MudStack Row="false">
                            @foreach (var questionSupport in AvailableQuestionSupports)
                            {
                                <MudPaper Class="pa-3 my-2" Elevation="2" >
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">

                                        <MudCheckBox T="bool"
                                                     Size="Size.Large"
                                                     Value="@EditedQuestion.QuestionSupports.Any(qs => qs.Id == questionSupport.Id)"
                                                     ValueChanged="@((bool value) => ToggleQuestionSupportLink(questionSupport, value))" />

                                        <MudDivider Vertical="true" FlexItem="true" />

                                        @questionSupport.GetSupportPreview()

                                    </MudStack>
                                </MudPaper>               
                            }
                        </MudStack>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <span>Não há textos de apoio disponíveis para esta prova.</span>                            
                        </div>
                    }                                     
                </MudTabPanel>
            </MudTabs>            
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="() => Dialog.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Salvar</MudButton>
    </DialogActions>
</MudDialog>
