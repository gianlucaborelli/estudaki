@using Estudaki.Modules.Questions.Application.DTOs
@inherits QuestionUnifyModalBase

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudText Typo="Typo.h6">Questões Disponíveis</MudText>
                <MudTable T="QuestionDto" Items="Questions"
                          @bind-SelectedItems="SelectedQuestions"
                          MultiSelection="true"
                          Dense="true">
                    <HeaderContent>
                        <MudTh>Questão</MudTh>
                        <MudTh>Cargo</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.GetQuestionPreview(100)</MudTd>
                        <MudTd>@string.Join(", ", context.Positions) (@context.Area)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>
            <MudItem xs="12" md="1">
                <MudDivider Vertical="true" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudText Typo="Typo.h6">Questões Selecionadas</MudText>
                <MudTable T="QuestionDto" Items="SelectedQuestions"
                          Dense="true">
                    <HeaderContent>
                        <MudTh>Questão</MudTh>
                        <MudTh>Cargo</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.GetQuestionPreview(100)</MudTd>
                        <MudTd>@string.Join(", ", context.Positions) (@context.Area)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Save">Confirmar</MudButton>
        <MudButton Color="Color.Secondary" OnClick="() => DialogInstance.Cancel()">Cancelar</MudButton>
    </DialogActions>
</MudDialog>
