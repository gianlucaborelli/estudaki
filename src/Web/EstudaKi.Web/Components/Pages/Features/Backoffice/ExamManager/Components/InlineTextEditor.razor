@using EstudaKi.Web.Components.Pages.Features.Questions.Components
@inherits InlineTextEditorBase

<div id="@editorId" style="position: relative;">
    <MudStack Row="true" Spacing="3">
        <MudItem>
            <MudIconButton Icon="@Icons.Material.Filled.FormatBold"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(async () => await ApplyFormatting("bold"))" />
        </MudItem>
        <MudItem>
            <MudIconButton Icon="@Icons.Material.Filled.FormatItalic"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(async () => await ApplyFormatting("italic"))" />
        </MudItem>
        <MudItem>
            <MudIconButton Icon="@Icons.Material.Filled.FormatUnderlined"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(async () => await ApplyFormatting("underline"))" />
        </MudItem>

        <MudDivider Vertical="true" Class="mx-2" />

        <MudItem>
            <MudIconButton Icon="@Icons.Material.Filled.Functions"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(async () => await ApplyFormatting("math"))" />
        </MudItem>
        <MudItem>
            <MudIconButton Icon="@Icons.Material.Filled.Science"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(async () => await ApplyFormatting("chemical"))" />
        </MudItem>
        <MudItem>
            <MudIconButton Icon="@Icons.Material.Filled.Image"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(async () => await ApplyFormatting("inline-image"))" />
        </MudItem>
    </MudStack>
    
    <MudTextField T="string"
                  Value="@Value.Text"
                  ValueChanged="@OnTextChanged"
                  Label="Texto (suporta HTML)"
                  FullWidth="true"
                  Lines="3"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  HelperText="Selecione o texto e escolha a formatação desejada" />

    @if (!string.IsNullOrEmpty(Value.Text))
    {
        <MudPaper Class="pa-3 mt-2" Outlined="true">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Pré-visualização:</MudText>
            <InlineContentRenderer Inline="Value" />
        </MudPaper>
    }
</div>
