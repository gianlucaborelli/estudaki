@page "/"
@using EstudaKi.Web.Components.Pages.Shared
@using MudBlazor
@using EstudaKi.Web.Components
@using EstudaKi.Web.Helpers
@using MudExtensions

<PageTitle>EstudaKi - Questões Gratuitas para Vestibular, Concurso e OAB</PageTitle>

<SeoHead 
    Title="EstudaKi - Questões Gratuitas para Vestibular, Concurso e OAB"
    Description="EstudaKi é um ambiente de estudo gratuito para praticar questões de vestibulares, concursos públicos e da OAB. Comece a estudar agora, sem cadastro."
    Keywords="questões vestibular, questões concurso, questões OAB, ENEM, Fuvest, simulado gratuito, estudar online, prova concurso"
    CanonicalUrl="https://estudaki.com.br/"
    JsonLd="@GetStructuredData()" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-10">

    <div>
        <MudText Typo="Typo.h1" Align="Align.Center" GutterBottom="true" Color="Color.Primary" Style="font-size: 2rem;">
            Comece agora. O <b>EstudaKi</b> é um ambiente de estudo livre para você praticar questões e ganhar confiança nas principais provas do país.
        </MudText>
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-6">
            Explore questões de vestibulares, concursos públicos e do exame da OAB, sem precisar de cadastro.
        </MudText>
    </div>

    <!-- Seção de Busca -->
   
    <MudTextField @bind-Value="SearchQuery"
                    Label="Buscar questões"
                    Placeholder="Digite palavras-chave para buscar questões..."
                    Variant="Variant.Outlined"
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    AdornmentColor="Color.Primary"
                    OnKeyDown="OnSearchKeyDown"
                    Immediate="false"
                    FullWidth="true"
                    Class="mb-4" />

    <div class="d-flex justify-center mt-1">
        <MudButton Variant="Variant.Text"
                   Class="pa-0"
                   OnClick="() => _showFilters =!_showFilters">
            @(_showFilters ? "Ocultar filtros" : "Mostrar filtros")
        </MudButton>
    </div>

    <MudCollapse Expanded="_showFilters">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="3">
                <MudSelect T="string"
                            @bind-SelectedValues="SelectedTypeQuestion"
                            MultiSelection="true"
                            Label="Tipo de Questão"
                            Variant="Variant.Outlined"
                            Margin="Margin.Dense"
                            Clearable="true"
                            AnchorOrigin="Origin.BottomCenter"
                            TransformOrigin="Origin.TopCenter"
                            ToStringFunc="@(value => QuestionTypeHelper.GetDisplayName(value))">
                    @foreach (var type in AvailableTypeQuestionsDisplay)
                    {
                        <MudSelectItem T="string" Value="@type.Value">@type.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudSelect T="string" Class="my-custom-textfield"
                            @bind-SelectedValues="SelectedExamCategory"
                            MultiSelection="true"
                            Label="Tipo de Prova"
                            Variant="Variant.Outlined"
                            Margin="Margin.Dense"
                            Clearable="true"
                            AnchorOrigin="Origin.BottomCenter"
                            TransformOrigin="Origin.TopCenter"
                            ToStringFunc="@(value => ExamCategoryHelper.GetDisplayName(value))">
                    @foreach (var category in AvailableExamCategoriesDisplay)
                    {
                        <MudSelectItem T="string" Value="@category.Value">@category.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudSelectExtended T="string" Class="my-custom-textfield my-custom-select"
                                    ItemCollection="AvailableMainAreas"
                                    @bind-SelectedValues="SelectedMainArea"
                                    MultiSelection="true"          
                                    Label="Área de conhecimento"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    Clearable="true"
                                    AnchorOrigin="Origin.BottomCenter"
                                    TransformOrigin="Origin.TopCenter" />
            </MudItem>

            <MudItem xs="12" md="3">
                <MudSelectExtended T="string" Class="my-custom-textfield"
                                    ItemCollection="AvailableSubAreas"
                                    @bind-SelectedValues="SelectedSubArea"
                                    MultiSelection="true"
                                    OnClearButtonClick="LoadingFilterParameters"
                                    OnClose="LoadingFilterParameters"
                                    Label="Subárea"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    Clearable="true"
                                    AnchorOrigin="Origin.BottomCenter"
                                    TransformOrigin="Origin.TopCenter" />
            </MudItem>

            <!-- Botões de Ação -->            
            <MudItem xs="12" Class="d-flex justify-center gap-2">
                <MudButton Variant="Variant.Outlined" 
                            Color="Color.Default" 
                            OnClick="ClearFilters"
                            StartIcon="@Icons.Material.Filled.Clear">
                    Limpar Filtros
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                            Color="Color.Primary" 
                            OnClick="ExecuteSearch"
                            StartIcon="@Icons.Material.Filled.Search">
                    Buscar
                </MudButton>
            </MudItem>
        </MudGrid>        
    </MudCollapse>

    <MudDivider Class="my-8" />

    <section aria-label="Benefícios da plataforma">
        <MudGrid GutterSize="3">
            <MudItem xs="12" sm="4">

                <MudText Typo="Typo.h6" Color="Color.Primary">Acesso Livre</MudText>
                <MudText Typo="Typo.body2">
                    Não precisa criar conta. Comece a estudar agora mesmo.
                </MudText>

            </MudItem>
            <MudItem xs="12" sm="4">

                <MudText Typo="Typo.h6" Color="Color.Primary">Diversas áreas</MudText>
                <MudText Typo="Typo.body2">
                    Questões de vestibulares, concursos públicos e exame da OAB organizadas por tema.
                </MudText>

            </MudItem>
            <MudItem xs="12" sm="4">

                <MudText Typo="Typo.h6" Color="Color.Primary">Novidades em breve</MudText>
                <MudText Typo="Typo.body2">
                    Em breve você poderá montar simulados e deixar comentários nas questões.
                </MudText>

            </MudItem>
        </MudGrid>
    </section>

    <MudDivider Class="my-8" />

    <section aria-label="Perguntas Frequentes">
        <MudText Typo="Typo.h2" GutterBottom="true" Color="Color.Primary" Style="font-size: 1.5rem;">Perguntas Frequentes</MudText>

        <MudExpansionPanels Elevation="1">
            <MudExpansionPanel Text="Preciso criar uma conta para usar?">
                Não! Todo o conteúdo está disponível gratuitamente e sem necessidade de login.
            </MudExpansionPanel>
            <MudExpansionPanel Text="Quais tipos de prova estão disponíveis?">
                Você encontrará questões de vestibulares (como ENEM e Fuvest), concursos públicos e da 1ª fase da OAB.
            </MudExpansionPanel>
            <MudExpansionPanel Text="Já posso montar simulados personalizados?">
                Ainda não, mas essa funcionalidade será lançada em breve.
            </MudExpansionPanel>
            <MudExpansionPanel Text="Posso comentar as questões?">
                Ainda não é possível, mas essa é outra funcionalidade planejada para as próximas atualizações.
            </MudExpansionPanel>
        </MudExpansionPanels>
    </section>

    </MudContainer>
