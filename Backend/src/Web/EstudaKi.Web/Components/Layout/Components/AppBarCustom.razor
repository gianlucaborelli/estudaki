@using EstudaKi.Web.Helpers
@using MudExtensions

@inherits AppBarCustomBase

<MudAppBar Elevation="1" Fixed="true">
    <AuthorizeView>
        <Authorized>
            <MudStaticNavDrawerToggle DrawerId="nav-drawer" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" />            
        </Authorized>
    </AuthorizeView>

    <!-- ESQUERDA -->
    <MudText Typo="Typo.h5"
                Class="pa-2"
                Style="cursor:pointer"
                @onclick="GoHome">

        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            EstudaKi
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            EK
        </MudHidden>
    </MudText>    

    <MudSpacer />

    <!-- DIREITA -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">

        <DarkModeToggleSwitch IsDarkMode="@IsDarkMode" IsDarkModeChanged="@OnDarkModeChanged" />

        <AuthorizeView>
            <Authorized>                
                @{
                    var userName = context.User.Identity?.Name;
                    var firstLetter = userName?.Substring(0, 1).ToUpper() ?? "?";
                }
                <MudMenu Dense
                         Variant="Variant.Text"
                         Size="Size.Medium"
                         Color="Color.Inherit">

                    <ActivatorContent Context="activator">
                        <MudAvatar Color="Color.Primary" Style="cursor:pointer;">
                            @firstLetter
                        </MudAvatar>
                    </ActivatorContent>

                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.Person">
                            @context.User.Identity?.Name
                        </MudMenuItem>

                        <MudMenuItem Icon="@Icons.Material.TwoTone.Settings"
                                     IconColor="Color.Secondary"
                                     Href="Account/Manage">
                            Settings
                        </MudMenuItem>

                        <MudDivider />

                        <form action="Account/Logout" method="post" class="w-100">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />

                            <button type="submit" class="mud-menu-item w-100 text-start">
                                <MudIcon Icon="@Icons.Material.Filled.Logout"
                                         Color="Color.Primary"
                                         Class="mr-2" />
                                Sign Out
                            </button>
                        </form>
                    </ChildContent>
                </MudMenu>
            </Authorized>

            <NotAuthorized>
                <MudNavLink Href="Account/Login"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Password">
                    Login
                </MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudStack>
</MudAppBar>
