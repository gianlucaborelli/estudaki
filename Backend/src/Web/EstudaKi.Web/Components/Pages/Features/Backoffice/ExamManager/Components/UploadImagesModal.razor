@using Estudaki.Modules.Questions.Domain.Entities
@using Estudaki.Modules.Questions.Domain.ValueObjects
@using Microsoft.AspNetCore.Components.Forms
@inherits UploadImagesModalBase

<MudDialog>
    <DialogContent>
        @if (IsUploading)
        {
            <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-3">
                Fazendo upload dos arquivos ...
            </MudText>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        }

        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5" Class="fw-bold">
                @ExamCategories.GetDisplayName(Notice!.ExamCategory!)
            </MudText>

            <MudSpacer />

            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                Nº @Notice!.Number
            </MudChip>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                @((Notice!.Year > 0) ? Notice.Year.ToString() : "Ano não definido")
            </MudChip>
        </MudStack>
            
        <MudDivider />

        <InputFile @ref="fileInputComponent" 
                   OnChange="OnFilesChanged" 
                   multiple 
                   accept="image/*" 
                   style="display: none;" 
                   id="hiddenFileInput" />

        <MudPaper Class="pa-4 my-4" Outlined="true" Style="cursor: pointer;">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" />
                <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            OnClick="OpenFilePicker"
                            StartIcon="@Icons.Material.Filled.CloudUpload">
                    Selecione o Arquivo do Gabarito para Upload
                </MudButton>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Ou arraste e solte arquivos aqui
                </MudText>
            </MudStack>
        </MudPaper>
        
        <MudDivider /> 

        <MudPaper Class="pa-4 my-4" Outlined="true" Style="border-style: dashed; border-width: 2px; cursor: pointer;"
                  id="pasteArea"
                  tabindex="0"
                  @onclick="FocusPasteArea">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.ContentPaste" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Cole Imagens Aqui (Ctrl+V)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    Clique nesta área e pressione <MudChip T="string" Size="Size.Small" Variant="Variant.Text">Ctrl</MudChip> + <MudChip T="string" Size="Size.Small" Variant="Variant.Text">V</MudChip> para colar imagens da área de transferência
                </MudText>
                @if (pasteAreaFocused)
                {
                    <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small">
                        Pronto para colar!
                    </MudChip>
                }
            </MudStack>
        </MudPaper>

        @if (SelectedFiles?.Any() == true)
        {
            <MudPaper Class="pa-3 my-3" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-3">Arquivos Selecionados (@SelectedFiles.Count)</MudText>
                <MudTable Items="@SelectedFiles.Select((f, i) => new { File = f, Index = i })" 
                          Hover="true" 
                          Dense="true" 
                          Bordered="true"
                          Striped="true">
                    <HeaderContent>
                        <MudTh Style="width: 50px;">#</MudTh>
                        <MudTh>Nome do Arquivo</MudTh>
                        <MudTh Style="width: 120px;">Tamanho</MudTh>
                        <MudTh Style="width: 150px;">Status</MudTh>
                        <MudTh Style="width: 80px;">Ações</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="#">@(context.Index + 1)</MudTd>
                        <MudTd DataLabel="Nome do Arquivo">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                                <MudText>@context.File.Name</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Tamanho">@FormatFileSize(context.File.Size)</MudTd>                        
                        <MudTd DataLabel="Ações">
                            @if (!IsLoading)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Color="Color.Error" 
                                               Size="Size.Small"
                                               OnClick="() => RemoveFile(context.File.Name)" />
                            }
                        </MudTd>
                    </RowTemplate>                    
                </MudTable>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Dialog.Cancel" Disabled="@(IsUploading || CanUpload())">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="UploadFiles" Disabled="@IsUploading">
            @if (IsLoading)
            {
                @("Enviando...");
            }
            else
            {
                @($"Enviar (@(SelectedFiles?.Count ?? 0) arquivo(s))")
            }
        </MudButton>
    </DialogActions>
</MudDialog>
