@using Estudaki.Commons.Core.Storage
@using Estudaki.Modules.Questions.Application.DTOs
@using Estudaki.Modules.Questions.Domain.Entities
@using Estudaki.Modules.Questions.Domain.ValueObjects

@inherits UploadExamFilesModalBase

<MudDialog>
    <DialogContent>
        @if (IsUploading)
        {
            <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-3">
                Fazendo upload dos Arquivos ...
            </MudText>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        }       
        
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5" Class="fw-bold">
                @ExamCategories.GetDisplayName(Notice!.ExamCategory!)
            </MudText>

            <MudSpacer />

            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                Nº @Notice!.Number
            </MudChip>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                @((Notice!.Year > 0) ? Notice.Year.ToString() : "Ano não definido")
            </MudChip>
        </MudStack>        
            
        <MudDivider/>

        <MudFileUpload Disabled="@IsUploading"
                        Accept=".pdf"
                        @bind-Files="examFile">
            <CustomContent>
                <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            OnClick="@context.OpenFilePickerAsync"
                            StartIcon="@Icons.Material.Filled.CloudUpload">
                    Selecione o Arquivo do Caderno de Questões para Upload
                </MudButton>
            </CustomContent>
        </MudFileUpload>

        <MudFileUpload DragAndDrop="true"
                        Disabled="@IsUploading"
                        Accept=".pdf"       
                        @bind-Files="answerKeyFile" >
            <CustomContent>
                <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            OnClick="@context.OpenFilePickerAsync"
                            StartIcon="@Icons.Material.Filled.CloudUpload">
                    Selecione o Arquivo do Gabarito para Upload
                </MudButton>
            </CustomContent>                       
        </MudFileUpload>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Dialog.Cancel" Disabled="@IsUploading">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="UploadFiles" Disabled="@IsUploading">Salvar</MudButton>
    </DialogActions>
</MudDialog>
