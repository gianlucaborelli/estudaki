@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<style>
    /* Esconder o "X" fantasma do mhchem no preview */
    #@previewId .mord.rlap {
        display: none !important;
    }

    /* Preview da fórmula química */
   
</style>

<MudTextField Value="@Formula"
              ValueChanged="@(async (string value) => await OnFormulaInput(value))"
              Variant="Variant.Outlined"
              Immediate="true"
              Label="Fórmula Química"
              Lines="2" />

<div class="mb-2">
    <label class="form-label fw-bold">Preview (Renderizado):</label>
    <div class="chemical-preview border rounded p-3 bg-light" 
            id="@previewId" 
            style="min-height: 50px; font-size: 1.2rem;">
    </div>
</div>

@code {
    [Parameter] public string? Formula { get; set; }
    [Parameter] public EventCallback<string> FormulaChanged { get; set; }

    private string previewId = $"chemical-preview-{Guid.NewGuid()}";
    private bool isRendered = false;

    protected override void OnParametersSet()
    {
        _ = UpdatePreview();        
    }    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isRendered = true;
            await UpdatePreview();
        }
    }

    private async Task OnFormulaInput(string newValue)
    {
        if (Formula == newValue)
            return;

        Formula = newValue;
        await FormulaChanged.InvokeAsync(Formula);
        await UpdatePreview();
    }

    private async Task UpdatePreview()
    {
        if (!isRendered) return;
            await JSRuntime.InvokeVoidAsync("ChemicalHelper.renderStatic", previewId, Formula ?? string.Empty);
    }
}
