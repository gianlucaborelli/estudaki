@using Estudaki.Commons.Core.Storage
@using Estudaki.Modules.Questions.Domain.Entities
@using Estudaki.Modules.Questions.Domain.Extensions

@inherits ImageSelectorModalBase

<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="py-5">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Color="Color.Secondary">Carregando imagens do S3...</MudText>
            </MudStack>
        }
        else if (images.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.Warning">
                Nenhuma imagem encontrada no S3 para esta prova.                
            </MudAlert>
        }
        else
        {
            <MudPaper Class="mb-3" Outlined="true" Style="border-style: dashed; border-width: 2px; border-color: var(--mud-palette-success);">
                <InputFile id="imageSelectorPasteInput"
                           @ref="pasteInputFileRef"
                           OnChange="OnPastedImageSelected"
                           style="display: none;"
                           accept="image/*" />

                <MudStack AlignItems="AlignItems.Center" 
                          Spacing="2" 
                          Class="pa-3"
                          Style="cursor: pointer;"
                          id="imageSelectorPasteArea"
                          tabindex="0"
                          @onclick="FocusPasteArea">
                    <MudIcon Icon="@Icons.Material.Filled.ContentPaste" Color="Color.Success" Size="Size.Large" />
                    <MudText Typo="Typo.body1" Align="Align.Center">
                        <strong>Cole uma imagem aqui (Ctrl+V)</strong> para fazer upload e selecioná-la automaticamente
                    </MudText>

                    @if (isUploading)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressCircular Size="Size.Small" Color="Color.Success" Indeterminate="true" />
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Enviando...</MudChip>
                        </MudStack>
                    }
                    else if (pasteAreaFocused)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                            Pronto para colar!
                        </MudChip>
                    }
                </MudStack>
            </MudPaper>

            @if (!string.IsNullOrEmpty(uploadMessage))
            {
                <MudAlert Severity="Severity.Info" 
                          CloseIcon="@Icons.Material.Filled.Close"
                          CloseIconClicked="() => uploadMessage = null"
                          Class="mb-3">
                    @uploadMessage
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(uploadError))
            {
                <MudAlert Severity="Severity.Error" 
                          CloseIcon="@Icons.Material.Filled.Close"
                          CloseIconClicked="() => uploadError = null"
                          Class="mb-3">
                    @uploadError
                </MudAlert>
            }

            <MudTextField @bind-Value="searchTerm"
                          Placeholder="Buscar por nome da imagem..."
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyUp="FilterImages"
                          Class="mb-3" />

            <MudGrid Spacing="3">
                @foreach (var image in filteredImages)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudCard Class="@(selectedImageKey == image.Key ? "mud-theme-primary" : "")"
                                 Style="cursor: pointer; height: 100%;"
                                 Outlined="@(selectedImageKey != image.Key)"
                                 Elevation="@(selectedImageKey == image.Key ? 8 : 1)"
                                 @onclick="() => SelectImage(image.Key)">
                            <MudCardContent Class="pa-2">
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 150px; background-color: var(--mud-palette-background-grey);">
                                    @if (image.IsLoaded)
                                    {
                                        @if (image.HasError)
                                        {
                                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Filled.BrokenImage" Size="Size.Large" Color="Color.Secondary" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Erro ao carregar</MudText>
                                                <MudTooltip Text="@image.Url">
                                                    <MudText Typo="Typo.caption" Class="text-truncate" Style="max-width: 150px;">@image.Url</MudText>
                                                </MudTooltip>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <img src="@image.Url"
                                                 alt="@image.Key"
                                                 style="max-height: 150px; max-width: 100%; object-fit: contain;"
                                                 @onerror="() => OnImageError(image)" />
                                        }
                                    }
                                    else
                                    {
                                        <MudProgressCircular Size="Size.Small" Color="Color.Secondary" Indeterminate="true" />
                                    }
                                </MudStack>

                                <MudStack Class="mt-2" Spacing="1">
                                    <MudTooltip Text="@image.Key">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">
                                            @image.Key
                                        </MudText>
                                    </MudTooltip>

                                    @if (selectedImageKey == image.Key)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                                            Selecionada
                                        </MudChip>
                                    }
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            @if (filteredImages.Count == 0 && !string.IsNullOrWhiteSpace(searchTerm))
            {
                <MudAlert Severity="Severity.Info" Class="mt-3">
                    Nenhuma imagem encontrada com o termo "@searchTerm".
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="Close">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="Confirm" Disabled="@string.IsNullOrEmpty(selectedImageKey)">Confirmar</MudButton>
    </DialogActions>
</MudDialog>