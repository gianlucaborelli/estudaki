@using Estudaki.Modules.Questions.Domain.Entities
@using Estudaki.Modules.Questions.Domain.ValueObjects

@inherits EditPublicNoticeModalBase

<MudDialog>
    <DialogContent>     
        <MudForm @ref="Form" Model="@EditedPublicNotice">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="EditedPublicNotice.Number" Label="Número"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="EditedPublicNotice.Year" Label="Ano"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="EditedPublicNotice.ContractingOrganization" Label="Organização Contratante"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="EditedPublicNotice.ExaminerOrganization" Label="Banca Examinadora"/>
                </MudItem>                
                <MudItem xs="12" md="6">
                    <MudSelect @bind-Value="EditedPublicNotice.ExamCategory" Label="Categoria do Exame" >
                    @foreach (var category in ExamCategories.All)
                    {
                        <MudSelectItem Value="@category">@ExamCategories.GetDisplayName(category)</MudSelectItem>
                    }
                </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid Class="py-5">                                                
                        <MudCheckBox @bind-Value="EditedPublicNotice.IsPublished" Label="Publicado" />
                        <MudSpacer />
                        <MudCheckBox @bind-Value="EditedPublicNotice.IsReviewed" Label="Revisado" />
                    </MudGrid>
                </MudItem>                
            </MudGrid>
        </MudForm>        
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Dialog.Cancel" Disabled="@IsUploading">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Disabled="@IsUploading" OnClick="SavePublicNotice">Salvar</MudButton>
    </DialogActions>
</MudDialog>
