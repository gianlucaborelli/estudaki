@inherits ApproveQuestionReviewModalBase

<MudDialog Style="width: 80vw; max-width: 80vw;">
    <DialogContent>
        <MudText Class="mb-3">Confira as alterações antes de aprovar a atualização da questão.</MudText>
        <MudGrid>
            <MudItem xs="6">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Atual</MudText>
                <QuestionReviewPreview Value="OriginalQuestion" />
            </MudItem>
            <MudItem xs="6">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Atualizado</MudText>
                <QuestionReviewPreview Value="UpdatedQuestion" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Confirm">Confirmar</MudButton>
    </DialogActions>
</MudDialog>
