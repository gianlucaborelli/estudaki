@page "/Error/404"
@inject ILogger<NotFound> Logger
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager

<PageTitle>Página não encontrada - EstudaKi</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-10">
    <MudPaper Class="pa-8" Elevation="2">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <div style="position: relative; width: 200px; height: 200px;">
                <MudText Typo="Typo.h1"
                         Style="font-size: 120px; font-weight: 800; color: var(--mud-palette-primary); opacity: 0.1; position: absolute; top: 0; left: 50%; transform: translateX(-50%);">
                    404
                </MudText>
                <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                         Color="Color.Primary"
                         Style="font-size: 100px; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);" />
            </div>

            <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: 600;">
                Oops! Página não encontrada
            </MudText>

            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="px-4">
                Parece que você se perdeu! A página que você está procurando não existe ou foi movida para outro endereço.
            </MudText>

            <MudDivider Class="my-4" Style="width: 80%;" />

            <MudStack Spacing="2" Class="full-width px-4">
                <MudText Typo="Typo.body2" Align="Align.Center" Style="font-weight: 500;">
                    Experimente:
                </MudText>
                <MudStack Spacing="1">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Verificar se o URL está correto</MudText>
                    </MudStack>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Voltar para a página inicial</MudText>
                    </MudStack>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Usar a busca para encontrar questões</MudText>
                    </MudStack>
                </MudStack>
            </MudStack>

            <MudDivider Class="my-4" Style="width: 80%;" />

            <MudStack Row="true" Spacing="2" Class="mt-4" Wrap="Wrap.Wrap" Justify="Justify.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Home"
                           OnClick="GoToHome">
                    Página Inicial
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="GoBack">
                    Voltar
                </MudButton>
            </MudStack>

            <MudLink Href="/result" Typo="Typo.body2" Color="Color.Primary" Class="mt-2">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                    <span>Buscar questões</span>
                </MudStack>
            </MudLink>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private void GoToHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo(NavigationManager.Uri);
    }
}
